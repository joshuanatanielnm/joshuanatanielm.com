# Keystatic (GitHub storage in production)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Site
NEXT_PUBLIC_IS_OPEN_TO_WORK=false

# Spotify integration (optional)
# The site renders fine without these — the Now Playing widget falls back to
# the static "listening" text and the "On repeat" section is hidden.
#
# How to generate:
# 1. Create an app at https://developer.spotify.com/dashboard and copy the
#    Client ID + Client Secret.
# 2. Authorize your account with these scopes and exchange the code for a
#    refresh token:
#      user-read-currently-playing
#      user-read-recently-played
#      user-top-read
# 3. Paste the long-lived refresh token below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
